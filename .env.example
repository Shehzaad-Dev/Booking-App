# Booking app environment example
# Copy to .env and fill values.

# RapidAPI shared key for Booking endpoints (or leave empty to use mocks)
RAPIDAPI_KEY=

# Booking API
BOOKING_API_BASE_URL=https://booking-com15.p.rapidapi.com/api/v1
BOOKING_API_HOST=booking-com15.p.rapidapi.com

# Auth API (Login/Signup)
AUTH_API_BASE_URL=https://login-signup.p.rapidapi.com/public/v1
AUTH_API_HOST=login-signup.p.rapidapi.com

# Optional separate auth key; falls back to RAPIDAPI_KEY when empty
RAPIDAPI_AUTH_KEY=
